# Chave da OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=coloque_sua_api_aqui

# Modelo usado pelo supervisor e pelos especialistas.
MODEL=openai/gpt-4o-mini

# Temperatura 0: roteamento e handoff precisam ser reproduzíveis.
TEMPERATURE=0.0
MAX_TOKENS=700

# --- Conversa em grupo (AutoGen) ---
# Rodadas do gerente: escolher quem fala, coletar a resposta, transmitir.
MAX_RODADAS=8
# Respostas automáticas consecutivas com o mesmo agente. É o teto que impede
# dois agentes de conversarem para sempre sem ninguém intervir.
MAX_AUTO_RESPOSTA=3
# Passos de ferramenta de um especialista por handoff.
MAX_PASSOS_FERRAMENTA=4
# Vezes que o supervisor pode acionar o mesmo especialista seguidamente.
MAX_REPETICAO_ESPECIALISTA=2

# --- Salvaguardas (CAMEL) ---
# Detecções de modo de falha antes de encerrar a conversa.
MAX_SALVAGUARDAS=3

# --- RAG usado como ferramenta ---
RAG_TOP_K=3
RAG_TAMANHO_CHUNK=900
RAG_SOBREPOSICAO=150
