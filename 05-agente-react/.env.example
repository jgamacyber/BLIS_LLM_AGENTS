# Chave da OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=coloque_sua_api_aqui

# Modelo que decide as ações do agente.
MODEL=openai/gpt-4o-mini

# Temperatura 0: um agente que escolhe ações precisa ser reproduzível.
# Com temperatura alta, o mesmo erro não se repete e não dá para depurar.
TEMPERATURE=0.0
MAX_TOKENS=600

# --- Loop ReAct ---
# Passos antes de encerrar com TLE (Task Limit Exceeded, do AgentBench).
MAX_PASSOS=8
# Saídas seguidas fora do formato antes de encerrar com IF (Invalid Format).
MAX_ERROS_FORMATO=3
# Repetições da mesma ação com a mesma entrada antes de cortar o laço.
MAX_REPETICOES=3

# --- Memória hierárquica (MemGPT) ---
# Orçamento da janela simulada, em tokens estimados (~4 caracteres por token).
JANELA_CONTEXTO=4000
# 70% da janela dispara o aviso de pressão de memória.
LIMIAR_PRESSAO=0.7
# No estouro, metade da fila é despejada para o recall storage.
FRACAO_FLUSH=0.5
# Working context, em caracteres.
TAMANHO_WORKING_CONTEXT=1200
# Resultados por página nas buscas de memória.
PAGINA_MEMORIA=3
